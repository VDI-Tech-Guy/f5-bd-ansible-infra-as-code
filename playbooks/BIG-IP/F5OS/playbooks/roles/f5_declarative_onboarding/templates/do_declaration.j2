{# templates/do_declaration.j2                                                #}
{# Rendered per-node. Derived from the OpenShift/VMware do_declaration.j2    #}
{# with one key F5OS difference: VLANs are already created and assigned at   #}
{# the F5OS partition layer — inside the tenant they appear as untagged       #}
{# interfaces (1.1, 1.2, 1.3). There is no additional tagging to apply here. #}
{# f5_networks drives VLAN / interface / SelfIP config.                       #}
{
  "schemaVersion": "1.0.0",
  "class": "Device",
  "async": true,
  "label": "{{ hostvars[node_name].f5_hostname }} onboarding",

  "Common": {
    "class": "Tenant",

{% if f5_license_type == 'bigiq' %}
    "myLicense": {
      "class": "License",
      "licenseType": "licensePool",
      "bigIqHost": "{{ bigiq_host }}",
      "bigIqUsername": "{{ bigiq_username }}",
      "bigIqPassword": "{{ bigiq_password }}",
      "licensePool": "{{ bigiq_pool }}",
      "reachable": true,
      "bigIpUsername": "admin",
      "bigIpPassword": "{{ f5_admin_password }}",
      "overwrite": true
    },
{% elif f5_license_type == 'regkey' %}
    "myLicense": {
      "class": "License",
      "licenseType": "regKey",
      "regKey": "{{ f5_license_key_node1 if node_name == f5_primary_node else f5_license_key_node2 }}"
    },
{% endif %}

    "myDns": {
      "class": "DNS",
      "nameServers": {{ f5_dns_servers | to_json }},
      "search": {{ f5_dns_search | to_json }}
    },

    "myNtp": {
      "class": "NTP",
      "servers": {{ f5_ntp_servers | to_json }},
      "timezone": "{{ f5_timezone }}"
    },

    "mySystem": {
      "class": "System",
      "hostname": "{{ hostvars[node_name].f5_hostname }}",
      "cliInactivityTimeout": 1200
    },

    "myProvisioning": {
      "class": "Provision",
{% for mod in f5_modules %}
      "{{ mod | lower }}": "nominal"{{ "," if not loop.last else "" }}
{% endfor %}
    },

{% for net in f5_networks %}
    "vlan-{{ net.name }}": {
      "class": "VLAN",
      "tag": {{ net.vlan_id }},
      "mtu": 1500,
      "interfaces": [
        {
          "name": "{{ net.bigip_iface }}",
          "tagged": false
        }
      ]
    },

{% endfor %}
{% for net in f5_networks %}
    "self-{{ net.name }}": {
      "class": "SelfIp",
      "address": "{{ hostvars[node_name]['f5_self_' + net.name] }}",
      "vlan": "vlan-{{ net.name }}",
      "allowService": "{{ 'none' if net.name == 'external' else 'default' }}",
      "trafficGroup": "traffic-group-local-only"
    },

{% endfor %}
    "self-internal-float": {
      "class": "SelfIp",
      "address": "{{ f5_float_internal }}",
      "vlan": "vlan-internal",
      "allowService": "default",
      "trafficGroup": "traffic-group-1"
    },

    "self-external-float": {
      "class": "SelfIp",
      "address": "{{ f5_float_external }}",
      "vlan": "vlan-external",
      "allowService": "none",
      "trafficGroup": "traffic-group-1"
    },

    "myDefaultRoute": {
      "class": "Route",
      "gw": "{{ f5_route_gateway }}",
      "network": "default",
      "mtu": 1500
    },

    "myConfigSync": {
      "class": "ConfigSync",
      "configsyncIp": "{{ hostvars[node_name].f5_self_ha | ansible.utils.ipaddr('address') }}"
    },

    "myFailoverUnicast": {
      "class": "FailoverUnicast",
      "address": "{{ hostvars[node_name].f5_self_ha | ansible.utils.ipaddr('address') }}"
    },

    "myMirror": {
      "class": "MirrorIp",
      "primaryIp": "{{ hostvars[node_name].f5_self_ha | ansible.utils.ipaddr('address') }}"
    },

    "myDeviceGroup": {
      "class": "DeviceGroup",
      "type": "sync-failover",
      "members": [
        "{{ hostvars[f5_primary_node].f5_hostname }}",
        "{{ hostvars[f5_secondary_node].f5_hostname }}"
      ],
      "owner": "/Common/myDeviceGroup/members/0",
      "autoSync": true,
      "fullLoadOnSync": false,
      "asmSync": false,
      "networkFailover": true
    },

    "myDeviceTrust": {
      "class": "DeviceTrust",
      "localUsername": "admin",
      "localPassword": "{{ f5_admin_password }}",
      "remoteHost": "{{ hostvars[f5_primary_node].f5_mgmt_ip }}",
      "remoteUsername": "admin",
      "remotePassword": "{{ f5_admin_password }}"
    }
  }
}
